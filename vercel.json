{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "EXPO_PUBLIC_API_URL=https://otto-api-production-ed8a.up.railway.app EXPO_PUBLIC_SHARE_URL=https://otto-financas.vercel.app EXPO_PUBLIC_APK_URL=https://otto-financas.vercel.app/OTTO.apk npx expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/divida/:token", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/OTTO.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=OTTO.apk" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    }
  ]
}
