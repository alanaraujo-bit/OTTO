# Never commit a real value. Railway supplies these in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=3333

# Otto, the in-app assistant. Server only — never an EXPO_PUBLIC_* variable, never in the app.
# Without OPENAI_API_KEY the API still boots and /v1/assistant answers 503 "ainda não foi configurado".
OPENAI_API_KEY=
# Optional. Defaults to gpt-6.1-sol (DEFAULT_MODEL in src/assistant.js).
OPENAI_MODEL=
# Optional: low | medium | high | xhigh | max. Defaults to low (chat latency).
OPENAI_REASONING_EFFORT=
# Optional cost guards. Defaults: 2500 output tokens per call, 60 model calls per user per day,
# 200 model calls per day across everyone.
ASSISTANT_MAX_OUTPUT_TOKENS=
ASSISTANT_DAILY_CALLS=
ASSISTANT_GLOBAL_DAILY_CALLS=
